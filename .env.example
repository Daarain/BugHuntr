# ==============================================================================
# BugHuntr — Environment Variable Configuration Template
# Copy this file to .env.local for local development. Never commit .env.local to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SQL Database (Supabase PostgreSQL) — Auth & Security ONLY
# ------------------------------------------------------------------------------
# Authoritative store for:
# - auth_users (user identity & bcrypt hashes)
# - user_roles (hunter, company, admin, triager)
# - user_profiles (basic account profiles)
# - user_credentials (2FA secrets & recovery codes)
# - auth_audit_log (security audit trail)
#
# Serverless / Production Runtime: Use Supavisor/PgBouncer Transaction Pooler (port 6543)
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:6543/postgres?sslmode=require&pgbouncer=true
POSTGRES_URL=""
# Fallback connection string if POSTGRES_URL is not set:
DATABASE_URL=""

# ------------------------------------------------------------------------------
# 2. MongoDB — Application Data, Bounties, Wallets, Payouts & Submissions
# ------------------------------------------------------------------------------
# Authoritative store for:
# - organizations, org_members
# - bug_hunts, bug_submissions, vulnerabilities, cve_requests
# - org_wallets, payouts, payout_logs, batch_payout_jobs
# - user_points_balances, points_transactions, user_achievements
# - communities, community_memberships, community_messages
#
# Multi-document ACID transactions require a MongoDB Replica Set (Atlas or local replica set).
# Format: mongodb+srv://[USER]:[PASSWORD]@[CLUSTER-HOST]/[DATABASE]?retryWrites=true&w=majority
MONGODB_URI=""
MONGODB_DB_NAME="bughuntr"

# ------------------------------------------------------------------------------
# 3. Application Security & Authentication Secrets
# ------------------------------------------------------------------------------
# In production, set SESSION_SECRET to a strong, cryptographically random string (e.g., 64 hex characters).
SESSION_SECRET=""
INTERNAL_API_SECRET=""
AUTH_2FA_SECRET=""

# ------------------------------------------------------------------------------
# 4. Email Transport Configuration (Required for 2FA Email OTP Dispatch)
# ------------------------------------------------------------------------------
# Configure at least one provider for two-factor authentication challenge delivery:
# RESEND_API_KEY=""
# SENDGRID_API_KEY=""
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""

# ------------------------------------------------------------------------------
# 5. Staging Diagnostic Probe Safeguards (Opt-In Only)
# ------------------------------------------------------------------------------
# scripts/test-db-connections.ts requires RUN_STAGING_DB_PROBE="true" and APP_ENV="staging".
# It refuses to execute when NODE_ENV === "production" unconditionally.
# RUN_STAGING_DB_PROBE="false"
# APP_ENV="staging"
